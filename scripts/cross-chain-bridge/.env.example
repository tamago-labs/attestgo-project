# Copy to .env in repo root: cp scripts/.env.example .env
# Then fill SOURCE_CHAIN_RPC_URL + CREDITCOIN_WALLET_PRIVATE_KEY for write scripts (6+)
# Read-only scripts 1-2 need only RPC URLs.

# === Required for 1_check_chains.ts / 2_verify_single_view.ts ===
SOURCE_CHAIN_KEY=1
# 1 = Ethereum Sepolia on CC3 Testnet (use 3 for Ethereum Mainnet on testnet, 1 for mainnet on CC3 Mainnet)
SOURCE_CHAIN_RPC_URL="https://eth-sepolia.g.alchemy.com/v2/"
CREDITCOIN_RPC_URL="https://rpc.cc3-testnet.creditcoin.network"
PROOF_BUILDER_URL="https://prover.cc3-testnet.creditcoin.network"
# Alt testnet prover: https://proof-gen-api.cc3-testnet.creditcoin.network

# === AttestGO Sepolia (deployed 2026-08-24) tx 0x5314787a053480e78810a05e7a199a254b677172c5a21725715d1f06f0bd79a0 ===
SOURCE_CHAIN_CONTRACT_ADDRESS="0x052B3eAC16D43EF792589aae41BaD2205c6CC21C"
# legacy: 0x0F24FD9e0524BA53d3f0A4A40350Adf5370b4A53
# === Pre-deployed CC3 Testnet ===
USC_MINTER_CONTRACT_ADDRESS="0x2Be9B8640ED32815d3B9e8C92AbcD3F15F07396f"
USC_MINTABLE_TOKEN="0x914Cf96BF28b7b4921db27b264ecEd71aC91134E"

# === Vault (Option B) — after 4-DeployWrappedASTR + 5-DeployStreamVault ===
WRAPPED_ASTR_ADDRESS="0x5d03E2e40992194097989c4E73A31cb5a488d774" # wASTR from 4
STREAM_VAULT_ADDRESS="0x..." # from 5-DeployStreamVault
# === Only for write scripts (hello_bridge:submit_query / 6_+) ===
# Use a throwaway key — scripts will sign with this
CREDITCOIN_WALLET_PRIVATE_KEY="0x..."
